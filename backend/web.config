<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <handlers>
      <add name="PythonHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>
    <!-- Updated path to the confirmed virtual environment -->
    <httpPlatform processPath="C:\agentic-ai\venv\Scripts\python.exe"
                  arguments="-m uvicorn server:app --host 0.0.0.0 --port %HTTP_PLATFORM_PORT%"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\backend.log"
                  startupTimeLimit="120">
      <environmentVariables>
        <environmentVariable name="PYTHONPATH" value="C:\agentic-ai\neev-project\backend" />
        <environmentVariable name="SENDER_EMAIL" value="support@neevios.com" />
        <environmentVariable name="SENDER_PASSWORD" value="q#F5$~T1CT+" />
        <environmentVariable name="SMTP_SERVER" value="smtp.hostinger.com" />
        <environmentVariable name="SMTP_PORT" value="465" />
        <environmentVariable name="SECRET_KEY" value="prod-secret-key-123" />
        <environmentVariable name="AI_URL" value="http://127.0.0.1:8000" />
      </environmentVariables>
    </httpPlatform>
  </system.webServer>
</configuration>
